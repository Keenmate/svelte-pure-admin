{
  "//": "Capability manifest for <FilterCard> — svelte-pure-admin. See card.map.json for the model. The show* flags default TRUE in the component, so scenarios that want a clean structural __actions pass them false. isExpanded is $bindable but accepts an initial value.",
  "component": "filter-card",
  "features": {
    "loading":             { "prop": "isLoading",                 "kind": "bool" },
    "isDisabled":            { "prop": "isDisabled",                "kind": "bool" },
    "expanded":            { "prop": "isExpanded",                "kind": "bool" },
    "showToggle":          { "prop": "hasToggle",                 "kind": "bool" },
    "showClear":           { "prop": "hasClear",                  "kind": "bool" },
    "showRefresh":         { "prop": "hasRefresh",                "kind": "bool" },
    "showAdvancedActions": { "prop": "hasAdvancedActions",        "kind": "bool" },
    "filters":             { "prop": "filters",                   "kind": "slot" },
    "advancedFilters":     { "prop": "advancedFilters",           "kind": "slot" },
    "actions":             { "prop": "actions",                   "kind": "slot" }
  }
}
