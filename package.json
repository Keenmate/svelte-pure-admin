{
  "name": "svelte-pure-admin-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev -w docs",
    "dev:lib": "npm run dev -w @keenmate/svelte-pure-admin",
    "build": "npm run build -w @keenmate/svelte-pure-admin",
    "build:docs": "npm run build -w docs",
    "build:all": "npm run build && npm run build:docs",
    "package": "npm run package -w @keenmate/svelte-pure-admin",
    "check": "npm run check -w @keenmate/svelte-pure-admin && npm run check -w docs",
    "check:lib": "npm run check -w @keenmate/svelte-pure-admin",
    "check:docs": "npm run check -w docs",
    "preview": "npm run preview -w docs",
    "publish:lib": "npm run package && npm publish -w @keenmate/svelte-pure-admin --access public",
    "sync:snippets": "node scripts/sync-snippets.js",
    "sync:snippets:update": "node scripts/sync-snippets.js --update",
    "fidelity": "node scripts/fidelity/dump.mjs --all && node ../pure-admin/packages/core/fidelity/compare-all.mjs --wrapper svelte",
    "clean": "npm run clean -w @keenmate/svelte-pure-admin && npm run clean -w docs"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@keenmate/pure-admin-core": "^3.3.0-rc06"
  }
}
